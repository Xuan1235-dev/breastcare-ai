# Local default is SQLite at data/history.db. For cloud, set DATABASE_URL to PostgreSQL.
DATABASE_URL=

# Telegram Bot (keep these values in Backend environment only)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SMTP email. For Gmail, use an App Password, not your normal account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Public frontend origin(s), comma-separated
FRONTEND_ORIGIN=http://127.0.0.1:5173

# Agent: false = local numerical analysis + retrieval, without external requests.
# true sends 30 feature values and conversation to OpenAI (no patient identifiers).
AGENT_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

