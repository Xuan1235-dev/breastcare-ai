"""API for an educational Wisconsin Breast Cancer machine-learning dashboard.

Run from project root: python -m uvicorn backend.main:app --reload
Only load trusted, locally generated joblib files. This is not a medical device.
"""
from pathlib import Path
import json
import math
import secrets
import joblib
import numpy as np
import pandas as pd
from fastapi import FastAPI, HTTPException, Query
from fastapi.middleware.cors import CORSMiddleware
from fastapi.staticfiles import StaticFiles
from pydantic import BaseModel, Field

ROOT = Path(__file__).resolve().parents[1]
MODEL_PATH = ROOT / 'models' / 'best_model.joblib'
METADATA_PATH = ROOT / 'models' / 'metadata.json'
DATA_PATH = ROOT / 'data' / 'breast_cancer.csv'
RESULTS_PATH = ROOT / 'results' / 'model_comparison.csv'

if not MODEL_PATH.is_file() or not METADATA_PATH.is_file():
    raise RuntimeError('Chua co mo hinh. Chay tu thu muc goc: python -m ml.train')

model = joblib.load(MODEL_PATH)  # Only trust models produced locally by this project.
metadata = json.loads(METADATA_PATH.read_text(encoding='utf-8'))
features = list(metadata['feature_names'])
threshold = float(metadata['threshold'])

if not DATA_PATH.is_file():
    raise RuntimeError('Chua co dataset. Chay: python -m ml.train')
dataset = pd.read_csv(DATA_PATH)
if 'malignant' not in dataset or not all(name in dataset.columns for name in features):
    raise RuntimeError('Dinh dang data/breast_cancer.csv khong hop le')

app = FastAPI(title='BreastCare ML — Education Dashboard', version='2.1.0')
app.add_middleware(
    CORSMiddleware,
    allow_origins=['http://localhost:5173', 'http://127.0.0.1:5173'],
    allow_methods=['GET', 'POST'],
    allow_headers=['*'],
)
app.mount('/charts', StaticFiles(directory=str(ROOT / 'results'), check_dir=False), name='charts')

DISCLAIMER = 'Chỉ phục vụ học tập và nghiên cứu, không dùng để chẩn đoán hoặc quyết định điều trị.'


class PredictionInput(BaseModel):
    values: list[float] = Field(min_length=30, max_length=30)


class BatchInput(BaseModel):
    rows: list[list[float]] = Field(min_length=1, max_length=100)


def validate_rows(rows):
    for i, row in enumerate(rows, start=1):
        if len(row) != len(features) or not all(math.isfinite(x) for x in row):
            raise HTTPException(status_code=422, detail=f'Mau {i} can du 30 gia tri so huu han')


def infer(rows):
    validate_rows(rows)
    frame = pd.DataFrame(rows, columns=features)
    probs = model.predict_proba(frame)[:, 1]
    return [
        {
            'prediction': 'Ác tính' if float(p) >= threshold else 'Lành tính',
            'malignant_probability': float(p),
            'threshold': threshold,
            'disclaimer': DISCLAIMER,
        }
        for p in probs
    ]


@app.get('/api/health')
def health():
    return {'status': 'ok', 'model_loaded': True, 'dataset_loaded': True, 'version': '2.1.0'}


@app.get('/api/info')
def info():
    return {
        'features': features,
        'model': metadata['model_name'],
        'threshold': threshold,
        'cv_recall': metadata.get('cv_recall'),
        'best_params': metadata.get('best_params', {}),
        'disclaimer': DISCLAIMER,
    }


@app.get('/api/examples')
def examples():
    return {
        'benign': dataset.loc[dataset.malignant == 0, features].iloc[0].astype(float).tolist(),
        'malignant': dataset.loc[dataset.malignant == 1, features].iloc[0].astype(float).tolist(),
    }


@app.get('/api/random-sample')
def random_sample(exclude_id: int | None = Query(default=None, ge=1)):
    """Choose one uniformly random record, without revealing its ground-truth label."""
    size = len(dataset)
    if size == 0:
        raise HTTPException(status_code=404, detail='Dataset trong')
    # Do not return the same record twice in a row when another record is available.
    if exclude_id is not None and 1 <= exclude_id <= size and size > 1:
        pos = secrets.randbelow(size - 1)
        if pos >= exclude_id - 1:
            pos += 1
    else:
        pos = secrets.randbelow(size)
    row = dataset.iloc[pos]
    return {
        'sample_id': pos + 1,
        'values': [float(row[f]) for f in features],
        'total_samples': size,
        'message': 'Mau thuc te tu dataset, nhan goc duoc an khi du doan.',
    }


@app.get('/api/random-batch')
def random_batch(count: int = Query(default=100, ge=1, le=100)):
    """Return uniformly sampled distinct WDBC rows, WITHOUT revealing target labels.

    Sampling without replacement within each request; subsequent requests can overlap.
    """
    size = len(dataset)
    if count > size:
        raise HTTPException(status_code=400, detail='So mau vuot qua kich thuoc dataset')
    positions = secrets.SystemRandom().sample(range(size), count)
    selected = dataset.iloc[positions]
    return {
        'rows': selected.loc[:, features].astype(float).values.tolist(),
        'sample_ids': [int(i) + 1 for i in positions],
        'count': count,
        'total_samples': size,
        'message': '100 mau ngau nhien tu WDBC. Nhan goc duoc an.',
    }


@app.get('/api/dataset')
def dataset_summary():
    count_benign = int((dataset.malignant == 0).sum())
    count_malignant = int((dataset.malignant == 1).sum())
    stats = []
    for feature in features:
        column = dataset[feature]
        stats.append({
            'name': feature,
            'min': float(column.min()),
            'max': float(column.max()),
            'mean': float(column.mean()),
            'std': float(column.std()),
            'benign_mean': float(dataset.loc[dataset.malignant == 0, feature].mean()),
            'malignant_mean': float(dataset.loc[dataset.malignant == 1, feature].mean()),
        })
    sample = dataset.sample(n=min(8, len(dataset)), random_state=42)
    return {
        'total': int(len(dataset)),
        'feature_count': len(features),
        'benign': count_benign,
        'malignant': count_malignant,
        'missing_values': int(dataset.isnull().sum().sum()),
        'features': stats,
        'preview': [
            {'id': int(idx) + 1, 'class': 'Ác tính' if int(row.malignant) else 'Lành tính',
             'radius': round(float(row['mean radius']), 2),
             'texture': round(float(row['mean texture']), 2),
             'area': round(float(row['mean area']), 2)}
            for idx, row in sample.iterrows()
        ],
    }


@app.get('/api/distribution')
def distribution(feature: str = Query(default='mean radius')):
    if feature not in features:
        raise HTTPException(status_code=404, detail='Feature not found')
    values = dataset[feature].to_numpy(dtype=float)
    edges = np.histogram_bin_edges(values, bins=14)
    benign, _ = np.histogram(dataset.loc[dataset.malignant == 0, feature], bins=edges)
    malignant, _ = np.histogram(dataset.loc[dataset.malignant == 1, feature], bins=edges)
    return {
        'feature': feature,
        'bins': [
            {'range': f'{edges[i]:.2f}–{edges[i + 1]:.2f}',
             'benign': int(benign[i]), 'malignant': int(malignant[i])}
            for i in range(len(edges) - 1)
        ],
    }


@app.get('/api/results')
def results():
    if not RESULTS_PATH.is_file():
        raise HTTPException(status_code=404, detail='Chua co ket qua huan luyen')
    rows = pd.read_csv(RESULTS_PATH)
    rows = rows.replace([np.inf, -np.inf], np.nan)
    rows = rows.where(pd.notna(rows), None)
    return {
        'models': rows.to_dict(orient='records'),
        'selected': metadata['model_name'],
        'threshold': threshold,
        'cv_recall': metadata.get('cv_recall'),
        'best_params': metadata.get('best_params', {}),
        'charts': ['confusion_matrix.png', 'roc_curve.png', 'model_comparison.png', 'feature_importance.png'],
    }


@app.post('/api/predict')
def predict(data: PredictionInput):
    return infer([data.values])[0]


@app.post('/api/predict-batch')
def predict_batch(data: BatchInput):
    return {'items': infer(data.rows), 'total': len(data.rows)}
